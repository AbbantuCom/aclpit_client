# Base URL of the aclpit_admin_api deployment this site reads content from
# and triggers cache revalidation on (server-only — never exposed to the browser).
ADMIN_API_URL=http://localhost:3000

# Same admin API base URL, but reachable from the browser — the contact form
# POSTs to this directly. aclpit_admin_api must have this site's own deployed
# origin listed in its CLIENT_ORIGIN env var, or the browser's cross-origin
# POST will be rejected by the admin API's CORS check.
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3000

# Shared secret this site's /api/revalidate route requires on incoming
# revalidation requests. Must match REVALIDATE_SECRET in aclpit_admin_api,
# since that's what it sends when a content section is saved.
REVALIDATE_SECRET=some-long-random-string-shared-with-the-admin-repo
